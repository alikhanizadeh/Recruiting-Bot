    {
      "parameters": {
        "jsCode": "return $input.all().map((inputItem, idx) => {\nconst result = inputItem.json;\nconst srcItem = $('Check Selected Job Id').itemMatching(idx).json.jobId ? $('Prepare Candidate with Job Data').itemMatching(idx) : $('Prepare General Candidate').itemMatching(idx);\nconst candidate = srcItem.json;\nlet resumeText;\nlet ocrPageCount = 0;\nif (candidate.resumePresent) {\n  if (result.IsErroredOnProcessing || Number(result.OCRExitCode) !== 1) {\n    const detail = Array.isArray(result.ErrorMessage) ? result.ErrorMessage.join('; ') : result.ErrorMessage;\n    throw new Error('OCR.space could not fully read the resume: ' + (detail || result.ErrorDetails || 'exit code ' + result.OCRExitCode));\n  }\n  const pages = Array.isArray(result.ParsedResults) ? result.ParsedResults : [];\n  resumeText = pages.map((page, index) => {\n    const text = String(page.ParsedText || '').trim();\n    return text ? '--- Page ' + (index + 1) + ' ---\\n' + text : '';\n  }).filter(Boolean).join('\\n\\n');\n  ocrPageCount = pages.length;\n  if (!resumeText) throw new Error('OCR.space returned no readable text. Check the PDF quality and OCR language detection.');\n} else {\n  resumeText = String(candidate.bodyText || '').trim();\n  if (!resumeText) throw new Error('Gmail message has no PDF attachment and no readable email text to analyze.');\n}\nif (resumeText.length > 50000) throw new Error('Resume or email text exceeds the 50,000-character analysis limit.');\nreturn { json: { ...candidate, resumeText, ocrPageCount }, binary: srcItem.binary || {}, pairedItem: { item: idx } };\n});"
      },
