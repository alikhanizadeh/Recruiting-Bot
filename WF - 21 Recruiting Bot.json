      "id": "472bef37-7bff-426d-bd32-5864e6802cbd",
      "name": "Gmail Trigger1",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [3440, 6096],
      "maxTries": 5,
      "credentials": {
        "gmailOAuth2": {
