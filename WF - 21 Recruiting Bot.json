        "jsCode": "const application = $('Split Pending Applications').item.json;\nconst resume = $input.item.binary?.data;\nif (!resume) throw new Error('Application resume download did not return a PDF file.');\nreturn { json: { senderName: application.fullName, senderEmail: application.email, bodyText: application.coverLetter || '', jobId: application.jobId, jobTitle: application.jobTitle, source: 'website', applicationId: application.id, resumePresent: true }, binary: { data: resume } };"
      },
