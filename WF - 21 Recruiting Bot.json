      "id": "c72a41cb-1913-4eb0-9f5b-ea10473d5baa",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [2368, 3552],
      "maxTries": 5,
      "credentials": {
        "gmailOAuth2": {
