    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $input.item.json;\nif (row.requested_job_id && !row.job_id) throw new Error('Selected job was not found in PostgreSQL. Run the jobs sync before analyzing applications.');\nconst asArray = (value) => {\n  if (Array.isArray(value)) return value;\n  if (typeof value !== 'string' || !value) return [];\n  try { const parsed = JSON.parse(value); return Array.isArray(parsed) ? parsed : []; } catch { return []; }\n};\nconst requirements = asArray(row.requirements);\nconst responsibilities = asArray(row.responsibilities);\nconst benefits = asArray(row.benefits);\nconst jobDescription = [row.description, row.summary, row.department && 'Department: ' + row.department, row.location && 'Location: ' + row.location, row.job_type && 'Type: ' + row.job_type, row.experience && 'Experience: ' + row.experience, row.salary && 'Salary: ' + row.salary, responsibilities.length && 'Responsibilities: ' + responsibilities.join('; '), requirements.length && 'Requirements: ' + requirements.join('; '), benefits.length && 'Benefits: ' + benefits.join('; ')].filter(Boolean).join('\\n');\nconst binary = row.source === 'website' ? $('Normalize Website Application1').item.binary : $('Normalize Candidate1').item.binary;\nconst submittedAt = row.source === 'website' ? $('Normalize Website Application1').item.json.submittedAt : $('Normalize Candidate1').item.json.submittedAt;\nconst phone = row.source === 'website' ? $('Normalize Website Application1').item.json.phone : $('Normalize Candidate1').item.json.phone;\nreturn { json: { phone, submittedAt, applicationId: row.application_id, senderName: row.sender_name, senderEmail: row.sender_email, bodyText: row.body_text, jobId: row.requested_job_id || '', jobTitle: row.title || row.requested_job_title || 'General application', jobDescription, source: row.source, resumePresent: row.resume_present }, binary };"
      },
