    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst body = item.json.body || item.json;\nconst binary = item.binary || {};\nconst fromRaw = body.From || body.from || '';\nconst emailMatch = fromRaw.match(/<([^>]+)>/);\nconst senderEmail = emailMatch ? emailMatch[1] : fromRaw.trim();\nconst nameMatch = fromRaw.match(/^\\\"?(.+?)\\\"?\\s*</);\nconst senderName = nameMatch ? nameMatch[1] : 'Unknown';\nlet bodyText = body.text || body.snippet || '';\nif (body.html && !bodyText) bodyText = body.html.replace(/<[^>]+>/g, ' ').trim();\nconst pdfKey = Object.keys(binary).find((key) => binary[key].mimeType === 'application/pdf' || (binary[key].fileName || '').toLowerCase().endsWith('.pdf'));\nconst resume = pdfKey ? binary[pdfKey] : undefined;\nconst toIso = (v) => { const d = new Date(v); return v && !isNaN(d) ? d.toISOString() : new Date().toISOString(); };\nconst submittedAt = toIso(body.Date || body.date || (body.internalDate ? Number(body.internalDate) : null));\nconst digitsFixed = String(bodyText).replace(/[\\u06F0-\\u06F9]/g, (c) => String(c.charCodeAt(0) - 0x06F0)).replace(/[\\u0660-\\u0669]/g, (c) => String(c.charCodeAt(0) - 0x0660));\nconst phoneMatch = digitsFixed.match(/(?:\\+98|0098|0)?9\\d{2}[\\s-]?\\d{3}[\\s-]?\\d{4}/) || digitsFixed.match(/\\+?\\d[\\d\\s\\-()]{8,16}\\d/);\nconst phone = phoneMatch ? phoneMatch[0].trim() : '';\nreturn { json: { phone, submittedAt, senderName, senderEmail, bodyText, jobId: '', jobTitle: 'General application', source: 'gmail', applicationId: '', resumePresent: Boolean(resume) }, binary: resume ? { data: resume } : {} };"
      },
