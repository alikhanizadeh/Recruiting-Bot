    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst d0 = j.submittedAt ? new Date(j.submittedAt) : new Date();\nconst d = isNaN(d0) ? new Date() : d0;\nconst parts = new Intl.DateTimeFormat('fa-IR-u-ca-persian-nu-latn', { timeZone: 'Asia/Tehran', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(d);\nconst p = Object.fromEntries(parts.map((x) => [x.type, x.value]));\nconst dateFa = p.year + '/' + p.month + '/' + p.day + ' - ' + p.hour + ':' + p.minute;\nconst src = $('Prepare Resume for Analysis').item;\nconst resumePresent = Boolean(src.json.resumePresent && src.binary && src.binary.data);\nconst esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst jobTitleFa = (!j.jobTitle || j.jobTitle === 'General application') ? 'درخواست عمومی' : j.jobTitle;\nconst cover = String(j.coverLetter || '').trim().slice(0, 1000) || 'توضیحی ثبت نشده است';\nconst telegramText = '🔔 <b>متقاضی جدید — پیشنهاد دعوت به مصاحبه!</b>\\n'\n  + '👤 <b>نام:</b> ' + esc(j.candidateName) + '\\n'\n  + '📧 <b>ایمیل:</b> ' + esc(j.candidateEmail) + '\\n'\n  + '💼 <b>موقعیت شغلی:</b> ' + esc(jobTitleFa) + '\\n'\n  + '📞 <b>شماره تماس:</b> ' + esc(j.phone || 'ثبت نشده') + '\\n'\n  + '📅 <b>تاریخ ثبت درخواست:</b> ' + dateFa + '\\n'\n  + '⭐ <b>امتیاز هوش مصنوعی:</b> ' + esc(j.score) + ' از 10\\n'\n  + '💬 <b>توضیحات هوش مصنوعی:</b> ' + esc(j.comment) + '\\n'\n  + '📝 <b>توضیحات متقاضی:</b> ' + esc(cover) + '\\n'\n  + '✅ از فیلتر خودکار (امتیاز 7 به بالا) عبور کرد. پیشنهاد می‌شود برای مصاحبه دعوت شود.';\nconst safeName = String(j.candidateName || 'نامشخص').replace(/[\\\\/:*?\"<>|]/g, ' ').trim();\nreturn { json: { ...j, dateFa, resumePresent, resumeLink: resumePresent ? '' : 'رزومه PDF ارسال نشده', resumeFileName: 'رزومه - ' + safeName + '.pdf', telegramText }, binary: resumePresent ? { data: src.binary.data } : {} };"
      },
