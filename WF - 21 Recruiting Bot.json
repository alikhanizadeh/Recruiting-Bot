    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  $1::text AS application_id,\n  $2::text AS sender_name,\n  $3::text AS sender_email,\n  $4::text AS body_text,\n  $5::text AS requested_job_id,\n  $6::text AS requested_job_title,\n  $7::text AS source,\n  $8::boolean AS resume_present,\n  job.job_id, job.title, job.department, job.location, job.job_type,\n  job.experience, job.salary, job.summary, job.description,\n  job.responsibilities, job.requirements, job.benefits, job.job_data\nFROM (SELECT 1) AS seed\nLEFT JOIN public.codenest_jobs AS job ON job.job_id = $5;",
        "options": {
          "queryReplacement": "={{ [$json.applicationId || '', $json.senderName || '', $json.senderEmail || '', $json.bodyText || '', $json.jobId || '', $json.jobTitle || '', $json.source || 'gmail', Boolean($json.resumePresent)] }}"
        }
