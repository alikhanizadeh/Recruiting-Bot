      "id": "44278559-0516-4451-9981-5ed83f1b3c34",
      "name": "OCR Resume with OCR.space",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [3984, 3520],
      "retryOnFail": true,
      "maxTries": 3,
