      "id": "1de337b9-ff4d-4e67-a374-fb7f8b13e09d",
      "name": "Fetch Selected Job from PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [3312, 3520],
