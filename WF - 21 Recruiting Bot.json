        "jsCode": "const application = $('Split Pending Applications').item.json;\nconst resume = $input.item.binary?.data;\nif (!resume) throw new Error('Application resume download did not return a PDF file.');\nconst toIso = (v) => { const d = new Date(v); return v && !isNaN(d) ? d.toISOString() : new Date().toISOString(); };\nconst submittedAt = toIso(application.createdAt || application.submittedAt || application.created_at || application.date);\nconst phone = String(application.phone || application.phoneNumber || application.phone_number || application.mobile || application.tel || '').trim();\nreturn { json: { phone, submittedAt, senderName: application.fullName, senderEmail: application.email, bodyText: application.coverLetter || '', jobId: application.jobId, jobTitle: application.jobTitle, source: 'website', applicationId: application.id, resumePresent: true }, binary: { data: resume } };"
