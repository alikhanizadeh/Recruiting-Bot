        "jsCode": "const rows = $input.all().map(i => i.json);\nconst jobs = rows.length === 1 && Array.isArray(rows[0].jobs) ? rows[0].jobs : rows;\nif (!Array.isArray(jobs) || jobs.length === 0) throw new Error('Jobs API response must contain a jobs array.');\nfor (const job of jobs) {\n  if (!job || typeof job.id !== 'string' || !job.id || typeof job.title !== 'string' || !job.title) throw new Error('Every job must include a non-empty id and title.');\n}\nreturn [{ json: { jobs, total: jobs.length } }];"
