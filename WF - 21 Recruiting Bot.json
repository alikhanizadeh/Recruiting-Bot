      "id": "b521f9ba-91c7-4ba7-bbb9-a3373cdbe927",
      "name": "Fetch Selected Job from PostgreSQL1",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [4384, 6064],
